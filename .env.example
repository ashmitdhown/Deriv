# Default run needs NO configuration. Everything below is only for the optional LLM generator.
# Enabling it sends ticket text + KB snippets to the chosen third-party provider.
LLM_ENABLED=false
DEFAULT_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LOG_LEVEL=INFO
